# Server-side only — never exposed to the client.
# Get a key at https://platform.openai.com/ and copy this file to .env.local
OPENAI_API_KEY=sk-...

# Invite-only access. JSON maps stable user ids to manually issued keys.
# Required in production; keys must be unique, header-safe, and 16–256 characters.
# WORKBENCH_ACCESS_KEYS={"martin":"replace-with-a-long-random-key"}
# CLI key used by `npm run golden` when access control is enabled.
# WORKBENCH_ACCESS_KEY=replace-with-a-long-random-key
# Owner reporting uses a separate key and always fails closed when it is absent.
# Never reuse an invite key here.
# WORKBENCH_OWNER_KEY=replace-with-a-different-long-random-key

# Optional: override the generation model (default: gpt-5.1)
# OPENAI_MODEL=gpt-5.1

# Usage logging. Rows always go to stdout prefixed "workbench.usage ".
# Optional: persist one row per real generation in Neon Postgres.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional: also append them to a JSONL file (used by the golden-prompt suite).
# USAGE_LOG_PATH=./usage.jsonl
# Optional: turn usage logging off entirely.
# USAGE_LOG=0

# Optional: USD per 1M tokens, for cost estimates. Look these up — the numbers
# below are a syntax illustration, NOT real pricing.
# USAGE_RATES={"gpt-5.1":{"input":0,"cachedInput":0,"output":0}}
