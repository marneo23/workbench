# Server-side only — never exposed to the client.
# Get a key at https://platform.openai.com/ and copy this file to .env.local
OPENAI_API_KEY=sk-...

# Optional: override the generation model (default: gpt-5.1)
# OPENAI_MODEL=gpt-5.1

# Usage logging. Rows always go to stdout prefixed "workbench.usage ".
# Optional: also append them to a JSONL file (used by the golden-prompt suite).
# USAGE_LOG_PATH=./usage.jsonl
# Optional: turn usage logging off entirely.
# USAGE_LOG=0

# Optional: USD per 1M tokens, for cost estimates. Look these up — the numbers
# below are a syntax illustration, NOT real pricing.
# USAGE_RATES={"gpt-5.1":{"input":0,"cachedInput":0,"output":0}}
